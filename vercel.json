{
  "buildCommand": "cd frontend && npm install --prefer-offline --no-audit && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://brainup-backend-coxl.onrender.com/api/:path*"
    },
    {
      "source": "/api",
      "destination": "https://brainup-backend-coxl.onrender.com/api/health"
    },
    {
      "source": "/health",
      "destination": "https://brainup-backend-coxl.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
